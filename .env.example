# ==========================================================
# CẤU HÌNH KẾT NỐI AIVEN KAFKA (Lấy tại tab Overview trên Aiven)
# ==========================================================

# 1. Địa chỉ Service URI của Aiven Kafka (VD: kafka-xxxx-project.aivencloud.com:12345)
KAFKA_BROKER=kafka-xxxx-project.aivencloud.com:12345

# 2. Phương thức xác thực: chọn "ssl" (dùng 3 file cert) hoặc "sasl" (dùng username/password)
KAFKA_AUTH_METHOD=ssl

# --- Nếu dùng KAFKA_AUTH_METHOD=ssl:
# Đặt 3 file tải từ Aiven (ca.pem, service.cert, service.key) vào thư mục ./certs/
KAFKA_CA_PATH=./certs/ca.pem
KAFKA_CERT_PATH=./certs/service.cert
KAFKA_KEY_PATH=./certs/service.key

# --- Nếu dùng KAFKA_AUTH_METHOD=sasl (Bật SASL trên Aiven):
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=your_aiven_password_here
KAFKA_SASL_MECHANISM=scram-sha-256

# 3. Cấu hình Topic & Consumer Group mặc định cho bài Demo
KAFKA_TOPIC=seminar-messages-demo
KAFKA_PARTITIONS=3
KAFKA_GROUP_ID=seminar-consumer-group

# 4. Cổng chạy Web Dashboard Demo
PORT=3000
